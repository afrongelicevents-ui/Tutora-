{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tutora",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// The free *.workers.dev address is the site's only address until tutora.co.zw is bought.
	// Set this to false once the custom domain is live.
	"workers_dev": true,
	"preview_urls": false,
	// Workers AI (the Pro AI test maker): FREE allowance only. Tutora keeps its own daily
	// counter and stops at 80% of the free 10,000 neurons (src/lib/server/ai-tests.ts).
	"ai": { "binding": "AI" },
	// The TEST site: same code, its own Worker, address and database branch, full of fake data.
	"env": {
		"test": {
			"name": "tutora-test",
			"workers_dev": true,
			"preview_urls": false,
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare"
			},
			"ai": { "binding": "AI" },
			"vars": { "TEST_SITE": "1" }
		}
	}
}
