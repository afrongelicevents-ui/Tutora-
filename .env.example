# Copy to .env for local development. Never commit real values.

# Postgres. Local: postgres://tutora:tutora@localhost:5432/tutora_dev
# Production: the Neon connection string (Neon dashboard -> Connect).
DATABASE_URL="postgres://tutora:tutora@localhost:5432/tutora_dev"

# Public site address. Change when tutora.co.zw is bought.
ORIGIN="http://localhost:5173"

# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# The tutor's email. Whoever signs up and confirms this address becomes the tutor (admin).
TUTOR_EMAIL=""

# Resend (https://resend.com). Leave empty in development: emails are printed to the terminal.
RESEND_API_KEY=""
EMAIL_FROM="Tutora <hello@tutora.co.zw>"

# Only for tests: a Postgres user that can create databases.
TEST_DATABASE_URL="postgres://tutora:tutora@localhost:5432/tutora_test"
